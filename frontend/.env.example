[TEMPLATE]
# The FastAPI backend origin. Defaults to the documented local API port.
# If the API runs elsewhere (see the run instructions in the progress notes),
# override this in a gitignored frontend/.env file.
VITE_API_BASE_URL=http://localhost:8000

# Optional: the n8n webhook that answers Ask VALORA with the estate's real
# briefing. Leave it unset and the Intelligence panel runs its local,
# clearly-labelled placeholder instead of pretending a model answered.
# VITE_N8N_INTELLIGENCE_URL=https://n8n.example.com/webhook/valora-intelligence
