# These names must match app/core/config.py's Settings class exactly.
ENVIRONMENT=development

# Full SQLAlchemy async connection string (not separate host/port/user/password fields)
DATABASE_URL=postgresql+asyncpg://valora_user:valora_password@localhost:5432/valora_db

# JWT Configuration
SECRET_KEY=replace-with-a-long-random-development-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser clients permitted to send credentialed API requests.
# Use a JSON array because Pydantic Settings parses complex environment values as JSON.
# 5173 is a host-run `npm run dev`; 4173 is the port the frontend
# service in docker-compose.yml publishes.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# Optional AI assist layer. Everything is OFF by default; the product must work
# with AI off. See docs/ADR-004-AI-Assist-Layer.md. Keep real keys out of git.
AI_ENABLED=false
AI_INSIGHTS_ENABLED=false
AI_TRIAGE_ENABLED=false
AI_PERSONAL_DATA_ALLOWED=false
# gemini | openai_compatible | fake  (fake is refused outside development/test)
AI_PROVIDER=gemini
AI_MODEL=
AI_TIMEOUT_SECONDS=15
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=600
AI_DAILY_CALL_CAP_PER_ESTATE=200

# Provider credentials (placeholders only - never commit real values)
GEMINI_API_KEY=
AI_COMPAT_BASE_URL=
AI_COMPAT_API_KEY=
